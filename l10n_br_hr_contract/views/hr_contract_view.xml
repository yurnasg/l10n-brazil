<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="l10n_br_hr_contract_view_form" model="ir.ui.view">
        <field name="model">hr.contract</field>
        <field name="name">l10n_br.hr.contract.view.form</field>
        <field name="priority">110</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='structure_type_id']" position="after">
                <field
                    name="admission_type_id"
                    options="{'no_create': True, 'no_open': True}"
                    required="1"
                />
                <field name="labor_bond_type_id" />
                <div
                    class="alert alert-warning mb-2"
                    role="alert"
                    invisible="not has_legacy_labor_regime"
                >
                    <strong
                >Attention:</strong> This contract uses a discontinued labor regime. Update the regime to CLT or Statutory.
                </div>
                <field
                    name="labor_regime_id"
                    options="{'no_create': True}"
                    required="1"
                />
            </xpath>
            <xpath expr="//group[@name='contract_details']" position="after">
                <group name="union" string="Union">
                    <field name="partner_union" />
                    <field name="discount_union_contribution" />
                </group>
            </xpath>
            <xpath expr="//div[@name='wage_period_label']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='wage_period_label']" position="after">
                <field
                    name="salary_unit"
                    class="oe_inline"
                    options="{'no_create': True, 'no_open': True}"
                    required="1"
                />
            </xpath>
            <xpath expr="//group[@name='contract_details']" position="inside">
                <field name="monthly_hours" />
                <field name="weekly_hours" />
                <field name="work_schedule_type" />
            </xpath>
            <xpath expr="//page[@name='information']" position="after">
                <page name="resignation_page" string="Resignation">
                    <div
                        class="alert alert-warning"
                        role="alert"
                        invisible="not legacy_termination_review"
                    >
                        <strong
                    >Attention:</strong> The resignation cause or notice of termination came from the previous version and has no equivalent in eSocial Table 19. Choose the current values.
                    </div>
                    <group name="resignation_group" string="Resignation">
                        <field name="resignation_cause_id" />
                        <field name="resignation_date" />
                        <field
                            name="by_death"
                            invisible="resignation_code not in ['10', '48', '49']"
                        />
                        <field
                            name="legacy_termination_review"
                            invisible="not legacy_termination_review"
                        />
                    </group>
                    <group
                        name="notice_of_terminationstring"
                        string="Notice of Termination"
                    >
                        <field name="notice_of_termination_id" />
                        <field name="notice_of_termination_date" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
