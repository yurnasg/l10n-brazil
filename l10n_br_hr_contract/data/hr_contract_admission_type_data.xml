<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
    ==============================================================================
    ORIGEM E PROVENIÊNCIA DA TABELA:
    - Órgão / Sistema: eSocial - Governo Federal / Ministério do Trabalho e Emprego
    - Tabela / Evento Oficial: Evento S-2200 (Cadastramento Inicial e Admissão)
      Campo: tpAdmissao (Tipos de Admissão do Trabalhador)
    - Versão do Leiaute: eSocial Versão S-1.3 (NT 06/2026 rev.)
    - Base Legal: Manual de Orientação do eSocial (MOS) e CLT
    ==============================================================================
    -->
    <record id="admission_type_1" model="hr.contract.admission.type">
        <field name="name">Admission</field>
        <field name="code">1</field>
    </record>

    <record id="admission_type_2" model="hr.contract.admission.type">
        <field name="name">Transfer from company of the same economic group</field>
        <field name="code">2</field>
    </record>

    <record id="admission_type_3" model="hr.contract.admission.type">
        <field name="name">Transfer from consortium member or consortium</field>
        <field name="code">3</field>
    </record>

    <record id="admission_type_4" model="hr.contract.admission.type">
        <field
            name="name"
        >Transfer due to succession, takeover, spin-off or merger</field>
        <field name="code">4</field>
    </record>

    <record id="admission_type_5" model="hr.contract.admission.type">
        <field name="name">Transfer of domestic employee</field>
        <field name="code">5</field>
    </record>

    <record id="admission_type_6" model="hr.contract.admission.type">
        <field name="name">Change of CPF</field>
        <field name="code">6</field>
    </record>

    <record id="admission_type_7" model="hr.contract.admission.type">
        <field
            name="name"
        >Transfer when the succeeded company is considered unfit</field>
        <field name="code">7</field>
    </record>
</odoo>
