<odoo>
    <record id="l10n_br_cnpj_search_fiscal_company_form" model="ir.ui.view">
        <field name="name">l10n_br_fiscal.company.form (in l10n_br_cnpj_search)</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="l10n_br_fiscal.fiscal_res_company_form" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <field name="cnae_secondary_ids" position="after">
                <field name="equity_capital" widget="monetary" />
            </field>
            <!-- next to the CNPJ that l10n_br_base shows to Brazilian companies;
                 the vat, left untouched, is the field of foreign ones -->
            <field name="vat_formatted_cnpj" position="replace">
                <label
                    for="vat_formatted_cnpj"
                    string="CNPJ"
                    invisible="not show_l10n_br"
                />
                <div class="o_row" colspan="1" invisible="not show_l10n_br">
                    <field name="vat_formatted_cnpj" nolabel="1" />
                    <button
                        name="action_open_cnpj_search_wizard"
                        type="object"
                        class="btn-sm btn-link mb4 fa fa-search oe_edit_only oe_inline"
                        aria-label="Pesquisar CNPJ"
                        title="Pesquisar CNPJ"
                    />
                </div>
            </field>
            <field name="phone" position="before">
                <field name="mobile" widget="phone" />
            </field>
        </field>
    </record>
</odoo>
