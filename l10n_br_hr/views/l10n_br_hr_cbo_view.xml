<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_l10n_br_hr_cbo_tree" model="ir.ui.view">
        <field name="name">l10n_br_hr.cbo.list</field>
        <field name="model">l10n_br_hr.cbo</field>
        <field name="arch" type="xml">
            <list string="Occupations">
                <field name="formatted_code" />
                <field name="code" optional="hide" />
                <field name="name" />
                <field name="internal_type" />
                <field name="parent_id" />
                <field name="active" optional="hide" />
            </list>
        </field>
    </record>

    <record id="view_l10n_br_hr_cbo_filter" model="ir.ui.view">
        <field name="name">l10n_br_hr.cbo.search</field>
        <field name="model">l10n_br_hr.cbo</field>
        <field name="arch" type="xml">
            <search string="Occupations">
                <field
                    name="code"
                    string="Code"
                    filter_domain="['|', ('code', 'ilike', self), ('formatted_code', 'ilike', self)]"
                />
                <field name="name" string="Occupation" />
                <field name="synonyms" string="Synonyms" />
                <field name="parent_id" string="Parent CBO / Family" />
                <separator />
                <filter
                    string="Occupations (Normal)"
                    name="filter_normal"
                    domain="[('internal_type', '=', 'normal')]"
                />
                <filter
                    string="Hierarchical Groups (View)"
                    name="filter_view"
                    domain="[('internal_type', '=', 'view')]"
                />
                <separator />
                <filter
                    string="Archived"
                    name="inactive"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        string="Parent CBO / Family"
                        name="group_parent_id"
                        context="{'group_by': 'parent_id'}"
                    />
                    <filter
                        string="Internal Type"
                        name="group_internal_type"
                        context="{'group_by': 'internal_type'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="view_l10n_br_hr_cbo_form" model="ir.ui.view">
        <field name="name">l10n_br_hr.cbo.form</field>
        <field name="model">l10n_br_hr.cbo</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Brazilian Classification of Occupations (CBO)">
                <sheet>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="text-bg-danger"
                        invisible="active"
                    />
                    <field name="active" invisible="1" />
                    <div
                        class="alert alert-warning mb-3"
                        role="alert"
                        invisible="active"
                    >
                        <strong>Attention:</strong> This CBO occupation code is archived or extinct in official Ministry of Labor (MTE) classifications. It is preserved for historical contract integrity.
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Occupation Title" />
                        <h1>
                            <field
                                name="name"
                                placeholder="e.g. Analista de desenvolvimento de sistemas"
                            />
                        </h1>
                    </div>
                    <group col="4">
                        <field name="code" />
                        <field name="formatted_code" />
                        <field name="internal_type" />
                        <field name="parent_id" />
                    </group>
                    <notebook>
                        <page
                            string="Synonyms &amp; Alternative Titles"
                            name="synonyms"
                            invisible="internal_type != 'normal'"
                        >
                            <field
                                name="synonyms"
                                placeholder="Market alternative titles and synonyms..."
                            />
                        </page>
                        <page
                            string="Child CBOs"
                            name="child_cbo"
                            invisible="internal_type != 'view'"
                        >
                            <field name="child_ids">
                                <list>
                                    <field name="formatted_code" />
                                    <field name="name" />
                                    <field name="internal_type" />
                                    <field name="active" optional="hide" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_l10n_br_hr_cbo">
        <field name="name">Brazilian Classification of Occupations (CBO)</field>
        <field name="res_model">l10n_br_hr.cbo</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_l10n_br_hr_cbo_filter" />
        <field name="context">{'search_default_filter_normal': 1}</field>
    </record>

    <menuitem
        action="action_l10n_br_hr_cbo"
        id="menu_view_post_cbo_form"
        parent="hr.menu_config_recruitment"
        name="CBO"
        sequence="2"
    />
</odoo>
