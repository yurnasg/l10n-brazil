<?xml version="1.0" ?>
<odoo>
    <record id="view_l10n_br_hr_job_form" model="ir.ui.view">
        <field name="name">l10n_br_hr_job.form</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='department_id']" position="after">
                <field name="cbo_is_archived" invisible="1" />
                <div
                    class="alert alert-warning mb-2"
                    role="alert"
                    invisible="not cbo_is_archived"
                >
                    <strong>Attention:</strong> The selected CBO occupation has been discontinued. Please select an active CBO code for this job position.
                </div>
                <field name="cbo_id" />
            </xpath>
        </field>
    </record>
</odoo>
